{
  "name": "@electron-bun-starter/electron",
  "version": "0.1.1",
  "private": true,
  "description": "A shared React experience powered by Electron and Bun.",
  "author": "electron-bun-starter",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": { "dev": "bun run src/dev.ts", "build": "bun build src/main.ts --outfile dist/main.cjs --target node --format cjs --external electron && bun build src/preload.ts --outfile dist/preload.cjs --target node --format cjs --external electron", "package:win": "electron-builder --win nsis portable", "package:win:dir": "electron-builder --win --dir", "typecheck": "tsc -p tsconfig.json" },
  "build": {
    "appId": "com.electronbunstarter.app",
    "productName": "Electron Bun Starter",
    "directories": { "output": "../../artifacts" },
    "asar": true,
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "../web/dist", "to": "renderer" },
      { "from": "../server/dist/server.exe", "to": "server/server.exe" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "artifactName": "Electron-Bun-Starter-${version}-${arch}.${ext}",
    "nsis": {
      "artifactName": "Electron-Bun-Starter-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electron Bun Starter"
    }
  },
  "devDependencies": { "@types/bun": "^1.4.0", "@types/node": "^22.0.0", "electron": "^34.0.0", "typescript": "^5.7.3" }
}
