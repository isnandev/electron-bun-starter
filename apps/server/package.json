{
  "name": "@electron-bun-starter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "build:executable": "bun build src/index.ts --compile --outfile dist/server.exe --minify",
    "start": "bun dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@electron-bun-starter/contracts": "workspace:*",
    "@electron-bun-starter/shared": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.7.3"
  }
}
